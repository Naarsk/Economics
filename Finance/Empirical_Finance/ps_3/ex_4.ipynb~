   "cell_type": "markdown",
   "source": "## 1) One equation\n",
   "id": "bb5aff973243cad2"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-04-06T11:59:36.713839Z",
     "start_time": "2025-04-06T11:59:36.707958Z"
    }
   },
   "cell_type": "code",
   "source": [
    "def myfun(gamma, excess_return, growth_consumption):\n",
    "    # Sample moments\n",
    "    G = np.mean(growth_consumption ** (-gamma) * excess_return)\n",
    "    # GMM objective function (identity weighting matrix)\n",
    "    GMM = G**2\n",
    "    return GMM.item()"
   ],
   "id": "6d82e614009178a1",
   "outputs": [],
   "execution_count": 11
  },
  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "Estimate the parameter $\\gamma$",
   "id": "4d728e6fe2bd40ab"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-04-06T18:43:51.687041Z",
     "start_time": "2025-04-06T18:43:51.669415Z"
    }
   },
   "cell_type": "code",
   "source": [
    "# Starting values for the parameters\n",
    "startvalues = 30\n",
    "\n",
    "# Run the optimizer (minimize the GMM objective)\n",
    "result = minimize(\n",
    "    fun=myfun,\n",
    "    x0=startvalues,\n",
    "    args=(data['Excess return'], data['Growth consumption'],))\n",
    "\n",
    "gamma = result.x      # Estimated parameters"
   ],
